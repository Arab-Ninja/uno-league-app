# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo
apps/web/dist/
apps/api/dist/

# env & secrets
.env
.env.*
!.env.example
*.pem

# capacitor native projects (generated by `npx cap add`)
# Le projet natif Android est **versionné** (DEPLOIEMENT §4).
#
# Il l'était autrefois ignoré, au motif que `cap add android` le régénère. Mais
# la régénération ne rend que le squelette : les permissions caméra et
# notifications, les icônes, le numéro de version et la clé de signature sont
# posés à la main par-dessus. Les perdre à chaque `cap add` revenait à
# reconstruire l'application avant chaque publication, et à découvrir l'oubli
# une fois la caméra silencieusement refusée sur un vrai téléphone.
#
# Ce qui reste ignoré ci-dessous est ce que Gradle et `cap sync` reconstruisent.
apps/web/android/.gradle/
apps/web/android/build/
apps/web/android/app/build/
apps/web/android/local.properties
apps/web/android/.idea/
# Le contenu web recopié par `cap sync` : c'est le build de `apps/web/dist`,
# dupliqué. Le versionner doublerait chaque livraison dans l'historique.
apps/web/android/app/src/main/assets/public/
# Les trois descripteurs de greffons, réécrits par `cap sync` à chaque appel et
# porteurs des chemins de `node_modules` de la machine qui l'a lancé. Avec pnpm,
# ces chemins contiennent la version et l'empreinte de chaque paquet : ils
# diffèrent d'une installation à l'autre, et leur suivi transformait chaque
# `git pull` en conflit sur des fichiers que personne n'écrit — ils portent
# eux-mêmes la mention « DO NOT EDIT THIS FILE ». `cap sync android`, que toute
# livraison lance de toute façon, les reconstruit.
apps/web/android/capacitor.settings.gradle
apps/web/android/app/capacitor.build.gradle
apps/web/android/capacitor-cordova-android-plugins/
# La clé de signature ne quitte jamais la machine qui publie (SEC-006).
*.keystore
*.jks
apps/web/android/keystore.properties

# Projet natif iOS, versionné pour la même raison qu'Android : ses permissions,
# ses icônes et sa version sont posées par-dessus le squelette, et un
# `cap add ios` les écraserait. Il se génère sur un Mac ; tant qu'il n'existe
# pas, ces lignes ne désignent rien et ne gênent personne.
#
# Seul ce que CocoaPods, Xcode et `cap sync` reconstruisent est ignoré.
apps/web/ios/App/Pods/
apps/web/ios/App/build/
apps/web/ios/DerivedData/
apps/web/ios/App/App.xcodeproj/xcuserdata/
apps/web/ios/App/App.xcworkspace/xcuserdata/
# Le contenu web recopié par `cap sync`, comme du côté Android.
apps/web/ios/App/App/public/

# runtime
uploads/
logs/
*.log
coverage/

# Dossier de présentation : seules les sources sont versionnées. Le reste — les
# captures, le module d'assets en base64, le HTML et le PDF — pèse trois
# mégaoctets et se refabrique en trois commandes (docs/dossier/README.md).
docs/dossier/captures/
docs/dossier/assets.py
docs/dossier/dossier.html
docs/dossier/*.pdf
docs/dossier/p*.png
docs/dossier/rendu/

# Outils Python ponctuels (scripts/portraits) : le cache d'octets, jamais.
__pycache__/
*.pyc

# editors / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Moteur WebAssembly de MediaPipe : recopié depuis node_modules au build
# (scripts/sync-vision-assets.mjs). Les modèles, eux, sont versionnés.
apps/web/public/vision/wasm/
