# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# IDE — on partage les configs d'équipe .vscode mais pas les préférences perso
# .vscode/ est intentionnellement tracké pour partager les extensions recommandées,
# la configuration de lancement (F5) et les réglages Copilot agent.
.idea/
.vscode/*.code-snippets
*.swp
*.swo
*~

# Logs
logs
*.log

# OS
Thumbs.db

# Build files
*.tgz
*.tar.gz
.cache/

# Webdev artifacts (checkpoint zips, migrations, etc.)
.webdev/
package-lock.json

# SQLite database (auto-created at runtime, not committed)
data/*.db
data/*.db-shm
data/*.db-wal
