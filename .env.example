# Copy this file to .env and fill in real values. Never commit .env.

# MySQL-compatible connection string for TiDB Cloud (or any MySQL-compatible DB).
DATABASE_URL=mysql://<user>:<password>@<host>:4000/<database>

# JWT signing secret for auth cookies.
JWT_SECRET=

# OAuth server base URL (if using the built-in OAuth flow).
OAUTH_SERVER_URL=
