# ---------------------------------------------------------------------------
# UNO League — configuration serveur
# Copiez ce fichier vers .env et renseignez les valeurs.
# Aucun secret ne doit être commité (SEC-006).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Base de données (MySQL 8 ou TiDB Cloud) -------------------------------
# Deux façons équivalentes de configurer la connexion.
#
# 1) Chaîne complète :
DATABASE_URL=mysql://uno:unolocal@127.0.0.1:3306/uno_league
#
# 2) Composants séparés — À PRÉFÉRER avec TiDB Cloud. Les mots de passe
#    générés contiennent souvent @ / : ? # ou %, qui coupent une URL écrite à
#    la main et produisent une erreur trompeuse. Sous cette forme, l'encodage
#    est fait pour vous.
#
#    ATTENTION : les cinq lignes ci-dessous sont commentées. Pour les
#    utiliser, RETIREZ LE # EN DÉBUT DE LIGNE et videz DATABASE_URL ci-dessus.
#    Une ligne qui commence par # est ignorée, même si elle est renseignée.
#
#    Si le mot de passe contient un « # », encadrez-le de guillemets droits :
#    sans cela, dotenv considère la suite comme un commentaire et ne lit que
#    le début — le serveur répond alors « accès refusé » sans autre indice.
#
# DATABASE_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
# DATABASE_PORT=4000
# DATABASE_USER=xxxxxxxx.root
# DATABASE_PASSWORD="votre#mot#de#passe"
# DATABASE_NAME=uno_league

DATABASE_POOL_SIZE=10

# TLS. Obligatoire pour TiDB Cloud et tout accès public : le certificat ET le
# nom d'hôte du serveur sont vérifiés.
DATABASE_SSL=false

# Autorité de certification privée uniquement. Inutile pour TiDB Cloud, dont
# le certificat est émis par une autorité publique déjà connue de Node.
# DATABASE_CA_PATH=

# --- Sessions ---------------------------------------------------------------
# Générez une valeur aléatoire : node scripts/secrets.mjs
SESSION_SECRET=changez-moi-par-une-valeur-aleatoire-de-32-caracteres-minimum
SESSION_TTL_DAYS=30
COOKIE_DOMAIN=
# Obligatoirement true en production (cookie envoyé uniquement en HTTPS).
COOKIE_SECURE=false

# Attribut SameSite du cookie de session.
# « lax » convient si l'app web et l'API partagent un site
# (mon-domaine.app + api.mon-domaine.app).
# « none » est OBLIGATOIRE si elles sont sur deux sites distincts — par
# exemple deux sous-domaines d'un hébergeur (xxx.onrender.com). Sinon la
# connexion réussit puis l'écran de connexion revient, sans erreur.
# « none » exige COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# --- Front ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost

# --- Compte administrateur initial (ADMIN-001) ------------------------------
# Créé au premier démarrage s'il n'existe pas. Changez le mot de passe ensuite.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Paiements externes (CAL-010) -------------------------------------------
# none = seuls les points UNO sont proposés dans l'interface.
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=http://localhost:5173/calendrier

# --- Notifications push (ANN-003) -------------------------------------------
# Générez la paire de clés une seule fois : node scripts/secrets.mjs
# Sans ces deux valeurs, le push est simplement désactivé — l'application
# continue de fonctionner et les notifications restent visibles dedans.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Adresse de contact transmise aux services de push (mailto: ou https://).
VAPID_SUBJECT=mailto:contact@unoleague.be

# --- Envoi de courrier (MAIL-001, AUTH-009) ---------------------------------
# Les quatre valeurs vont ensemble : le serveur refuse de démarrer avec trois.
# Elles se prennent dans le panneau de la boîte, chez l'hébergeur du domaine.
#
# Absentes, l'envoi est désactivé et rien ne casse — sauf une chose, qui mérite
# d'être dite : SANS COURRIER, UN MOT DE PASSE OUBLIÉ EST DÉFINITIF. Il
# n'existe aucun autre chemin de réinitialisation, pas même par
# l'administration.
MAIL_HOST=
# 587 avec STARTTLS est le réglage courant ; 465 chiffre dès la connexion. Le
# code déduit le chiffrement du port, il n'y a donc rien d'autre à régler.
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# L'expéditeur affiché. Il doit appartenir au domaine authentifié, sinon le
# message part en indésirable ou se fait refuser.
MAIL_FROM=UNO League <contact@unoleague.be>

# Racine publique du site, sans barre oblique finale (ex. https://unoleague.be).
# Requise dès que le courrier est configuré : un lien de réinitialisation doit
# mener quelque part. Elle n'est PAS déduite de l'en-tête Host de la requête —
# cet en-tête est fourni par le client, et s'en servir pour fabriquer un lien
# de sécurité est une faille connue (empoisonnement d'en-tête Host).
PUBLIC_WEB_URL=

# --- Stockage des images (SEC-005) ------------------------------------------
# local = disque du serveur ; s3 = S3 / Cloudflare R2.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# Préfixe public des fichiers envoyés (IMG-001).
# Relatif par défaut : l'adresse du serveur dépend de qui regarde — localhost
# depuis le PC, l'adresse du Wi-Fi depuis le téléphone — et n'a donc rien à
# faire dans la base. À renseigner en absolu uniquement avec STORAGE_DRIVER=s3,
# où le fichier est servi par le bucket : https://cdn.exemple.app
STORAGE_PUBLIC_URL=/uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Outils de développement (CDC §15) --------------------------------------
# Expose les routes de seed/reset. Doit rester false en production.
ENABLE_DEV_TOOLS=true

# ---------------------------------------------------------------------------
# Mode SQUAD (SQUAD-001)
# ---------------------------------------------------------------------------
# Le mode se construit par phases. Laissez `false` en production tant qu'il
# n'est pas terminé : le drapeau masque l'onglet **et** ferme les routes.
# Passez-le à `true` en développement pour l'essayer.
#
# Il commande aussi les **tournois entre clubs** (TOUR-001) : un tournoi
# oppose des SQUADs, il n'a donc rien à dire tant que le mode est fermé.
# L'onglet « Tournois » de la console disparaît avec lui.
FEATURE_SQUAD=false

# ---------------------------------------------------------------------------
# Mode Grand Foot (MODE-003)
# ---------------------------------------------------------------------------
# Football à onze sur gazon, gratuit, sur le seul terrain de Londerzeel.
# Le drapeau ferme le mode partout à la fois : il disparaît du calendrier, de
# l'écran des modes et de la console, **et** le serveur refuse d'en créer une
# séance. Le laisser `false` jusqu'à la première vraie session.
FEATURE_BIGFOOT=false
