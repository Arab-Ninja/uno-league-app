# ---------------------------------------------------------------------------
# UNO League — configuration serveur
# Copiez ce fichier vers .env et renseignez les valeurs.
# Aucun secret ne doit être commité (SEC-006).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Base de données (MySQL 8 ou TiDB Cloud) -------------------------------
DATABASE_URL=mysql://uno:unolocal@127.0.0.1:3306/uno_league
DATABASE_POOL_SIZE=10
# TiDB Cloud impose TLS : passez à true en production.
DATABASE_SSL=false

# --- Sessions ---------------------------------------------------------------
# Générez une valeur aléatoire : openssl rand -base64 48
SESSION_SECRET=changez-moi-par-une-valeur-aleatoire-de-32-caracteres-minimum
SESSION_TTL_DAYS=30
COOKIE_DOMAIN=
# Obligatoirement true en production (cookie envoyé uniquement en HTTPS).
COOKIE_SECURE=false

# --- Front ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost

# --- Compte administrateur initial (ADMIN-001) ------------------------------
# Créé au premier démarrage s'il n'existe pas. Changez le mot de passe ensuite.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Paiements externes (CAL-010) -------------------------------------------
# none = seuls les points UNO sont proposés dans l'interface.
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=http://localhost:5173/calendrier

# --- Stockage des images (SEC-005) ------------------------------------------
# local = disque du serveur ; s3 = S3 / Cloudflare R2.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_URL=http://localhost:4000/uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Outils de développement (CDC §15) --------------------------------------
# Expose les routes de seed/reset. Doit rester false en production.
ENABLE_DEV_TOOLS=true
