{
  "name": "uno-league",
  "private": true,
  "version": "1.0.0",
  "description": "UNO League - ligue amateur de futsal (webapp + wrapper iOS/Android)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm --filter @uno/api dev\" \"pnpm --filter @uno/web dev\"",
    "dev:mobile": "node scripts/lan.mjs && concurrently -k -n api,web -c blue,magenta \"pnpm --filter @uno/api dev\" \"pnpm --filter @uno/web dev:lan\"",
    "build": "pnpm --filter @uno/shared build && pnpm --filter @uno/api build && pnpm --filter @uno/web build",
    "check": "pnpm -r --parallel check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @uno/api db:generate",
    "db:migrate": "pnpm --filter @uno/api db:migrate",
    "db:check": "pnpm --filter @uno/api db:check",
    "db:seed": "pnpm --filter @uno/api db:seed",
    "db:reset": "pnpm --filter @uno/api db:reset",
    "secrets": "node scripts/secrets.mjs",
    "push:keys": "node scripts/secrets.mjs",
    "lan": "node scripts/lan.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  }
}
