{
  "name": "@uno/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --platform=node --target=node20 --bundle --format=esm --outfile=dist/index.js --external:mysql2 --external:express --external:pino --external:pino-http --external:helmet --external:cors --external:stripe --external:@aws-sdk/* --external:drizzle-orm --external:@trpc/server --external:superjson --external:zod --external:cookie --external:express-rate-limit --external:dotenv",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@trpc/server": "^11.18.0",
    "@uno/shared": "workspace:*",
    "cookie": "^1.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "stripe": "^22.6.1",
    "superjson": "^2.2.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  }
}
